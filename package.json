{
  "name": "macros",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:purity": "node --import tsx tools/check-purity.ts",
    "verify": "npm run check:purity && npm run typecheck && npm run test"
  }
}
