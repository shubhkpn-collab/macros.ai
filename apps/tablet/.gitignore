# Generated native shell. Produced by tools/hydrate-android-shell.mjs from the
# official RN template — not authored here, so not committed. The MACROS-owned
# manifest below IS tracked and the hydration script refuses to overwrite it.
android/*
!android/app
android/app/*
!android/app/src
android/app/src/*
!android/app/src/main
android/app/src/main/*
!android/app/src/main/AndroidManifest.xml

node_modules/

# NOTE: package-lock.json is deliberately NOT ignored. The owner generates it
# with `npm install` (no registry access here) and commits it once typecheck and
# the native launch are green — ignoring it would contradict that instruction
# and require `git add -f`.
