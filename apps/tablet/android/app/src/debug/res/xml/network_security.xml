<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY network policy.

  Cleartext is permitted for the emulator's route to the host machine and for
  loopback, and for nothing else. The base config stays FALSE, so this does not
  open the app to arbitrary plain HTTP — a blanket allow would follow the build
  into habit and eventually into a release.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="true">
    <!-- Android emulator alias for the developer's machine. -->
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>
</network-security-config>
