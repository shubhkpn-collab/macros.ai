<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Required. Without it the real device logs
    "socket failed: EPERM (Operation not permitted)" and React Native cannot
    reach Metro at all in development, nor the HTTPS API in production.
  -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Push-to-talk. Denied permission degrades to touch; it never crashes. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />

  <!--
    BLE scale. Android 12+ splits Bluetooth into runtime permissions;
    neverForLocation states plainly that MACROS does not derive location from a
    scan, which is true and avoids requesting a permission we do not need.
  -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
      android:usesPermissionFlags="neverForLocation" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <!-- Legacy devices below API 31 only. -->
  <uses-permission android:name="android.permission.BLUETOOTH"
      android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
      android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
      android:maxSdkVersion="30" />

  <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:theme="@style/AppTheme">
    <!--
      PORTRAIT ONLY, and the appliance is wall-powered and always on: the screen
      must not sleep mid-recipe, and rotating a mounted kitchen panel is not a
      real interaction.
    -->
    <activity
        android:name=".MainActivity"
        android:screenOrientation="portrait"
        android:keepScreenOn="true"
        android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode"
        android:launchMode="singleTask"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
